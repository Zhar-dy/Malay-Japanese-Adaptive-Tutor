# Copy this file to .env and change values if needed. Every setting is optional.
INDEX_PATH=data/indexes/grammar.sqlite3
LLM_MODEL=qwen3.5:4b
LLM_BASE_URL=http://127.0.0.1:11434
# 0 = unload the model after every answer (same as the CLI); 10m = keep it loaded for 10 minutes
LLM_KEEP_ALIVE=10m
EVAL_SEED=259
CLASSIFIER_DIR=models/jlpt-bert
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=1
APP_DB_PATH=data/app/tutor.sqlite3